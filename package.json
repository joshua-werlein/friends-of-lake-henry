{
  "name": "friends-of-lake-henry",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "test": "node --import ./tests/register.mjs --test tests/facebook.test.mjs tests/facebook-worker.test.mjs tests/raffle.test.mjs tests/raffle-selection.test.mjs tests/raffle-photos.test.mjs tests/video-presentation.test.mjs tests/video-verification.test.mjs tests/winner-prize.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:facebook-worker": "tsc -p workers/facebook-live/tsconfig.json",
    "build:facebook-worker": "esbuild workers/facebook-live/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=.wrangler/facebook-live-build/index.js",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:facebook-photos": "esbuild workers/facebook-live/photos-entry.ts --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:workers --outfile=.wrangler/facebook-photos-build/index.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "scripts": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "miniflare": "4.20251118.1",
    "typescript": "5.9.3",
    "@astrojs/cloudflare": "^12.6.12",
    "@cloudflare/workers-types": "^4.20251213.0",
    "astro": "^5.16.6"
  }
}
