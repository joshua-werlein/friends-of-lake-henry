{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "friends-of-lake-henry",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folh-db",
      "database_id": "527df871-e876-4924-81d0-5d0572b4dd7b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d7ea3cc7deef422789bfa015a3c1a6db"
    },
    {
      "binding": "CONFIG",
      "id": "b70df87ff3db4230a621d4a39ab24ff7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "folh-photos"
    }
  ],
  "vars": {
    "RAFFLE_AUTOMATIC_SELECTION_ENABLED": "true",
    "FB_SEASON_START": "2026-11-01T00:00:00-05:00",
    "FB_SEASON_END": "2026-12-01T00:00:00-06:00"
  }
}
