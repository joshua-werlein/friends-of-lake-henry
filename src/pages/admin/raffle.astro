---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = false;
---

<BaseLayout title="Admin | Raffle | Friends of Lake Henry">
    <div class="container" style="--maxw: 1100px;">
        <section class="card adminCard enter-block">
            <div class="adminHeader">
                <div class="adminTitle">
                    <div class="pageTop">
                        <div class="pageTopRow">
                            <a class="pill enter-block delay-1" href="/admin">ADMIN</a>

                            <form class="logoutForm enter-block delay-1" method="post" action="/api/admin/logout">
                                <button class="btn" type="submit">Log out</button>
                            </form>
                        </div>
                        <h1 class="h1-tight">Raffle</h1>
                    </div>
                    <p class="lead adminLead">Manage automatic drawing updates, manual video choices, and published winners.</p>
                </div>
            </div>
            <div id="pageStatus" class="status status--empty status--center" aria-live="polite"></div>
            <section class="panel adminPanel" style="margin-top:1rem" aria-labelledby="automaticHeading">
                <h2 id="automaticHeading">Automatic Facebook Live</h2>
                <label class="automationSwitch"><input id="automaticEnabled" type="checkbox" /> Enable automatic updates</label>
                <p>For November 2026 drawings only, around 6 PM Central. A manual video can be shown now; a newer verified drawing can replace it the following day.</p>
                <dl id="automaticDetails" aria-live="polite"></dl>
                <button class="btn" id="testDiscovery" type="button">Test discovery now</button>
                <p id="automaticMessage" role="status"></p>
            </section>
            <section class="panel adminPanel" style="margin-top:1rem" aria-labelledby="manualHeading">
                <h2 id="manualHeading">Manual Video</h2>
                <label class="label" for="latestVideoUrl">Facebook video URL</label>
                <input id="latestVideoUrl" class="input" inputmode="url" autocomplete="off" placeholder="https://www.facebook.com/page/videos/123/" />
                <div class="actions" style="margin-top:1rem"><button class="btn" id="saveLive" type="button">Show this video now</button><button class="btn" id="saveFallback" type="button">Save as fallback</button><a class="pill" href="/raffle">View raffle page</a></div>
                <p id="displayedVideo"></p><p id="videoSource"></p><p id="liveStatus" role="status"></p>
                <details><summary>Advanced settings</summary>
                    <label class="label" for="videoOrientation">Video orientation</label>
                    <select id="videoOrientation" class="input"><option value="auto">Automatic (portrait if unknown)</option><option value="portrait">Portrait override</option><option value="landscape">Landscape override</option></select>
                    <label class="label" for="videoDimensions">Verified dimensions (optional)</label>
                    <textarea id="videoDimensions" class="input" rows="3" placeholder='{"id":"VIDEO_ID","format":[{"width":720,"height":1280}]}'></textarea>
                    <p>Paste sanitized numeric dimensions only. Never paste a token or image URL.</p>
                    <button class="btn" id="saveOrientation" type="button">Save video layout</button><p id="orientationStatus" role="status"></p>
                </details>
            </section>

            <div class="panel adminPanel enter-block delay-4" style="margin-top: 1rem;">
                <div class="adminHeaderRow">
                    <h2 class="h2-zero">Daily winners</h2>
                    <div class="muted">Raffle</div>
                </div>
                <p><a class="pill" href="/admin/raffle/prizes">Review prize calendar</a> <a class="pill" href="/admin/raffle/photo-imports">Facebook photo imports</a></p>
                <div class="formGrid" style="margin-top: .85rem;">
                    <div class="field">
                        <label class="label" for="raffleMonth">Raffle month</label>
                        <input id="raffleMonth" class="input" type="month" autocomplete="off" />
                        <div class="muted" style="margin-top:.35rem;">
                            Select which month you’re editing.
                        </div>
                        <div class="muted" style="margin-top:.1rem;">
                            **Winners and raffle title are saved per month**
                        </div>
                    </div>

                    <div class="field span2">
                        <label class="label" for="raffleTitle">Raffle title (optional)</label>
                        <input id="raffleTitle" class="input" placeholder="30 Day / 30 Gun" autocomplete="off" />
                        <div class="muted" style="margin-top:.35rem;">
                            If set, this title will appear on the public raffle page for the selected month.
                        </div>
                        <div class="muted" style="margin-top:.1rem;">
                            **Leave blank and save to remove the title**
                        </div>
                    </div>

                    <div class="actions span2">
                        <button class="btn" id="saveRaffleMeta" type="button">Save raffle title</button>
                    </div>

                    <div class="span2">
                        <div id="metaStatus" class="status status--empty status--center" aria-live="polite"></div>
                    </div>
                </div>

                <div class="formGrid" style="margin-top: .85rem;">
                  <div class="field span2">
                    <label class="label" for="rafflePoster">Raffle poster image</label>
                    <form id="rafflePosterForm" method="post" action="/api/admin/raffle/poster" enctype="multipart/form-data">
                      <input id="rafflePosterMonthKey" type="hidden" name="monthKey" value="" />
                      <label class="btn" for="rafflePoster">Choose poster</label>
                      <input id="rafflePoster" class="input" type="file" name="poster" accept="image/jpeg,image/png,image/webp,image/gif" />
                      <button class="btn" type="submit">Upload</button>
                      <div class="muted" style="margin-top:.35rem;">
                        Upload the poster image for the selected raffle month.
                      </div>

                      <label class="label" for="rafflePosterAlt" style="margin-top:.75rem;">Poster alt text</label>
                      <input
                        id="rafflePosterAlt"
                        class="input"
                        name="alt"
                        placeholder='Example: "November 2026 30 Day Gun Giveaway poster for Friends of Lake Henry."'
                        autocomplete="off"
                      />

                      <div class="actions" style="margin-top:.75rem;">
                        <button class="btn" type="submit">Upload poster</button>
                      </div>
                    </form>
                    <div id="posterStatus" class="status status--empty status--center" aria-live="polite"></div>
                  </div>
                </div>

                <h3 id="winnerFormHeading" tabindex="-1">Add Winner</h3>
                <div id="winnerEntryForm" class="formGrid" style="margin-top: .85rem;">
                    <div class="field">
                        <label class="label" for="wDate">Date</label>
                        <input id="wDate" class="input" type="date" autocomplete="off" />
                    </div>

                    <div class="field">
                        <label class="label" for="wTicket">Ticket #</label>
                        <input id="wTicket" class="input" inputmode="numeric" placeholder="66" autocomplete="off" />
                    </div>

                    <div class="field span2">
                        <label class="label" for="wName">Name</label>
                        <input id="wName" class="input" placeholder="Kurt Thesing" autocomplete="off" />
                    </div>

                    <div class="field span2">
                        <label class="label" for="wTown">Hometown (optional)</label>
                        <input id="wTown" class="input" placeholder="Galesville" autocomplete="off" />
                    </div>

                    <div class="field">
                        <label class="label" for="wPlace">Place</label>
                        <select id="wPlace" class="input">
                            <option value="">Unknown / not confirmed</option>
                            <option value="1st place">First place</option>
                            <option value="2nd place">Second place</option>
                            <option value="3rd place">Third place</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="wPrize">Prize description (optional)</label>
                        <input id="wPrize" class="input" maxlength="250" placeholder="Prize or cash amount" />
                    </div>
                    <div class="field span2"><label for="scheduledPrizeSuggestion">Approved prize suggestions</label><select class="input" id="scheduledPrizeSuggestion"><option value="">Choose a verified prize suggestion (optional)</option></select><p id="scheduledPrizeHelp" class="muted">Manual prize entry remains available. Date matches do not establish prize placement.</p></div>
                    <p class="muted span2" id="prizeSchedule" aria-live="polite"></p>
                    <div class="actions span2">
                        <button class="btn" id="addWinner" type="button">Add Winner</button>
                        <button class="btn" id="cancelWinnerEdit" type="button" hidden>Cancel Editing</button>
                    </div>

                    <div class="span2">
                        <div id="winnersStatus" class="status status--empty status--center" aria-live="polite"></div>
                    </div>
                </div>

                <div class="winnersList" style="margin-top: 1rem;">
                    <div class="muted" id="winnersCount" style="margin:0 0 .5rem;"></div>
                    <div class="winnersTableWrap shade" role="region" aria-label="Admin winners list" tabindex="0">
                        <table class="winnersTable" id="winnersTable"><colgroup><col class="colDate"/><col class="colPlace"/><col class="colPrize"/><col class="colTicket"/><col class="colName"/><col class="colTown"/><col class="colActions"/></colgroup>
                            <thead>
                            <tr>
                                <th>Date</th>
                                <th>Place</th>
                                <th>Prize</th>
                                <th>Ticket</th>
                                <th>Name</th>
                                <th>Town</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <dialog id="winnerPrizeDialog" class="shade-dialog" aria-labelledby="winnerPrizeHeading" style="max-width:38rem;width:calc(100% - 2rem);max-height:90vh;overflow:auto;border:1px solid #67717e;border-radius:16px;color:#fff;padding:1.5rem;">
        <h2 id="winnerPrizeHeading">Edit winner prize</h2>
        <p id="editPrizeWinner"></p>
        <form id="winnerPrizeForm" class="formGrid">
            <div class="field span2"><label for="editPrizeCategory">Prize category</label><select id="editPrizeCategory" class="input"><option value="">Not specified</option><option>Firearm</option><option>Gift card</option><option>Cash</option><option>Other</option></select></div>
            <div class="field span2"><label for="editPrizeDescription">Prize description</label><textarea id="editPrizeDescription" class="input" rows="3" maxlength="250" required></textarea></div>
            <div class="field span2"><label for="editPrizePosition">Verified place</label><select id="editPrizePosition" class="input"><option value="">Unknown / not confirmed</option><option value="1">First place</option><option value="2">Second place</option><option value="3">Third place</option></select></div>
            <label class="span2"><input type="checkbox" id="editPrizePositionConfirmed" /> If a numeric place is selected, I verified it from an independent source.</label>
            <label class="span2"><input type="checkbox" id="editPrizeApproved" required /> I reviewed and approve this prize description for publication.</label>
            <p id="editPrizeStatus" class="span2" role="status"></p>
            <div class="actions span2"><button class="btn" type="submit">Approve and save prize</button><button class="btn" type="button" id="cancelPrizeEdit">Cancel</button></div>
        </form>
    </dialog>
    <script>import "../../scripts/raffle-prize-editor";</script>
    <script>import "../../scripts/raffle-prize-suggestions";</script>
    <script>import "../../scripts/raffle-orientation-admin";</script>
    <script>
        import { prizeCells, parseWinnerPrize } from "../../lib/winner-prize";
        function currentMonthKeyChicago() {
            // en-CA => YYYY-MM formatting is easy to slice
            return new Intl.DateTimeFormat("en-CA", {
                timeZone: "America/Chicago",
                year: "numeric",
                month: "2-digit",
                }).format(new Date()).slice(0, 7);
            }

        function monthKeyToLabel(monthKey) {
            const [y, m] = monthKey.split("-").map(Number);
            const d = new Date(Date.UTC(y, m - 1, 15, 12));
            return new Intl.DateTimeFormat("en-US", {
                timeZone: "America/Chicago",
                month: "long",
                year: "numeric",
            }).format(d);
        }
        const pageStatus = document.getElementById("pageStatus");

        function setPageStatus(kind, msg) {
            if (!(pageStatus instanceof HTMLElement)) return;
            if (!msg) {
                pageStatus.className = "status status--empty status--center";
                pageStatus.textContent = "";
                return;
            }
            pageStatus.className = `status status--${kind} status--center`;
            pageStatus.textContent = msg;
        }
        const rafflePosterMonthKey = document.getElementById("rafflePosterMonthKey");
        const raffleMonth = document.getElementById("raffleMonth");
        const raffleTitle = document.getElementById("raffleTitle");
        const saveRaffleMetaBtn = document.getElementById("saveRaffleMeta");
        const metaStatus = document.getElementById("metaStatus");
        const input = document.getElementById("latestVideoUrl");
        const btn = document.getElementById("saveLive");
        const liveStatus = document.getElementById("liveStatus");
        const videoMode = document.getElementById("videoSelectionMode");
        const saveVideoMode = document.getElementById("saveVideoMode");
        const videoModeStatus = document.getElementById("videoModeStatus");
        const posterStatus = document.getElementById("posterStatus");


        function setLiveStatus(kind, msg) {
            if (!(liveStatus instanceof HTMLElement)) return;
            if (!msg) {
                liveStatus.className = "status status--empty status--center";
                liveStatus.textContent = "";
                return;
            }
            liveStatus.className = `status status--${kind} status--center`;
            liveStatus.textContent = msg;
        }

        function setMetaStatus(kind, msg) {
            if (!(metaStatus instanceof HTMLElement)) return;
            if (!msg) {
                metaStatus.className = "status status--empty status--center";
                metaStatus.textContent = "";
                return;
            }
            metaStatus.className = `status status--${kind} status--center`;
            metaStatus.textContent = msg;
        }

        async function loadVideoSettings() {
            const res=await fetch('/api/admin/raffle/live');const data=await res.json();
            if(!res.ok||!data.ok)throw Error(data.error||'Could not load video settings.');
            input.value=data.config?.latestVideoUrl??'';input.dispatchEvent(new Event('change'));
            document.getElementById('automaticEnabled').checked=data.automaticEnabled;
            const errorMessages={'token-expired':'Facebook access has expired. An administrator must reconnect Facebook.','permission-denied':'Facebook has not granted the required access.','verification-required':'Livestream verification is incomplete. Use a manual video until setup is complete.','ambiguous-livestream':'Several broadcasts match this drawing. Please choose the correct video manually.','api-failure':'Facebook could not be reached. Your saved video is preserved.'};
            const detail=document.getElementById('automaticDetails');detail.replaceChildren();
            const values=[['Status',data.status],['Last successful Graph check',data.lastSuccessfulCheck],['Discovery result',data.discoveryStatus],['Publication receipt',data.receiptValid?'Current':'Missing or invalid for this policy'],['Last verified Live observation',data.lastLiveObservation],['Observed Live video',data.lastObservedLiveVideo],['Last automatic stage under current policy',data.lastStagedAt],['Last Facebook event',data.webhook?.lastEventReceivedAt],['Stored automatic video (may be from an earlier policy)',data.lastAutomaticVideo],['Videos awaiting confirmation',data.pendingVideos?.length?data.pendingVideos.map(v=>v.videoId+' (Live origin unproven)').join(', '):'None'],['Webhook',data.webhook?.configured?(data.webhook?.signedEventReceived?'Signed event received; processing still requires verification':'Receiver configured; Meta subscription and signed delivery unverified'):'Setup incomplete'],['Last error',data.lastError?(errorMessages[data.lastError.cause]||data.lastError.cause)+' '+(data.lastError.at||''):'None']];
            for(const [name,value]of values){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=name;dd.textContent=value||'None yet';dd.style.overflowWrap='anywhere';detail.append(dt,dd);}
            document.getElementById('displayedVideo').textContent='Currently displayed: '+(data.displayed?.latestVideoUrl||'Facebook page link');
            document.getElementById('videoSource').textContent='Video source: '+(data.source==='automatic'?'Automatic':'Manual');
        }
        async function videoAction(body,message) {
            try{const res=await fetch('/api/admin/raffle/live',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await res.json();if(!res.ok||!data.ok)throw Error(data.error||'Could not save.');await loadVideoSettings();setLiveStatus('success',message);return data;}
            catch(error){setLiveStatus('error',error.message||'Could not save.');return null;}
        }
        btn?.addEventListener('click',()=>videoAction({action:'showVideo',latestVideoUrl:input.value.trim()},'Video selected. Automatic updates keep their current setting.'));
        document.getElementById('saveFallback')?.addEventListener('click',()=>videoAction({action:'saveFallback',latestVideoUrl:input.value.trim()},'Fallback saved. Automatic updates keep their current setting.'));
        document.getElementById('automaticEnabled')?.addEventListener('change',event=>videoAction({action:'setAutomation',enabled:event.target.checked},event.target.checked?'Automatic updates enabled; setup and verification checks still apply.':'Automatic updates disabled.'));
        document.getElementById('testDiscovery')?.addEventListener('click',async()=>{
            const data=await videoAction({action:'testDiscovery'},'Discovery checked. The displayed video is unchanged.');
            if(!data)return;
            const result=data.result?.result;
            const discoveries=result?.discoveries??[];
            const candidate=discoveries.length===1?discoveries[0]:null;
            const format=candidate?.source==='format'&&Number.isInteger(candidate.width)&&Number.isInteger(candidate.height)
                ? ` Graph video format: ${candidate.width} × ${candidate.height}.` : '';
            document.getElementById('automaticMessage').textContent=data.result?.status==='error'
                ? 'Facebook check failed: '+(result?.reason||'unavailable')+'. The displayed video is unchanged.'
                : result?.pending?.length
                    ? 'Video '+result.pending.map(v=>v.videoId).join(', ')+' is waiting for manual Live-origin confirmation.'
                    : `Check complete. ${discoveries.length} verified candidate(s).${format} No video selection was changed.`;
        });
        loadVideoSettings().catch(error=>setLiveStatus('error',error.message));

        const wDate = document.getElementById("wDate");
        const wTicket = document.getElementById("wTicket");
        const wName = document.getElementById("wName");
        const wPlace = document.getElementById("wPlace");
        const wPrize = document.getElementById("wPrize");
        const wTown = document.getElementById("wTown");
        const addWinnerBtn = document.getElementById("addWinner");
        const winnersStatus = document.getElementById("winnersStatus");
        const winnersTable = document.getElementById("winnersTable");
        const winnersCount = document.getElementById("winnersCount");

        function setWinnersStatus(kind, msg) {
            if (!(winnersStatus instanceof HTMLElement)) return;
            if (!msg) {
                winnersStatus.className = "status status--empty status--center";
                winnersStatus.textContent = "";
                return;
            }
            winnersStatus.className = `status status--${kind} status--center`;
            winnersStatus.textContent = msg;
        }

        if (
            !(wDate instanceof HTMLInputElement) ||
            !(wTicket instanceof HTMLInputElement) ||
            !(wName instanceof HTMLInputElement) ||
            !(wTown instanceof HTMLInputElement) ||
            !(wPlace instanceof HTMLSelectElement) ||
            !(wPrize instanceof HTMLInputElement) ||
            !(addWinnerBtn instanceof HTMLButtonElement) ||
            !(winnersTable instanceof HTMLTableElement) ||
            !(winnersStatus instanceof HTMLElement) ||
            !(winnersCount instanceof HTMLElement) ||
            !(raffleMonth instanceof HTMLInputElement) ||
            !(raffleTitle instanceof HTMLInputElement) ||
            !(saveRaffleMetaBtn instanceof HTMLButtonElement) ||
            !(metaStatus instanceof HTMLElement)
        ) {
            setPageStatus("error", "Winners UI failed to initialize. Reload the page.");
        } else {
            if (!raffleMonth.value) {
                raffleMonth.value = currentMonthKeyChicago(); // YYYY-MM
            }
            if (!wDate.value) {
                wDate.value = new Intl.DateTimeFormat("en-CA", {timeZone: "America/Chicago", year: "numeric", month: "2-digit", day: "2-digit"}).format(new Date());
            }
            const dateMonth = wDate.value.slice(0, 7);

            if (dateMonth !== raffleMonth.value) {
                wDate.value = `${raffleMonth.value}-01`;
            }

            function updatePrizeSchedule() {
                document.getElementById("prizeSchedule").textContent = "Use the approved prize calendar or a verified announcement. Leave numeric place unknown unless independently confirmed.";
            }
            wDate.addEventListener("change", () => {
                wPlace.selectedIndex = 0;
                updatePrizeSchedule();
            });
            updatePrizeSchedule();

            function formatISODateMDY(iso) {
                if (!iso) return "";
                const m = String(iso).match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!m) return String(iso);
                const [, yyyy, mm, dd] = m;
                return `${mm}/${dd}/${yyyy}`;
            }

            function syncPosterMonthKey() {
                if (rafflePosterMonthKey instanceof HTMLInputElement && raffleMonth instanceof HTMLInputElement) {
                    rafflePosterMonthKey.value = raffleMonth.value || currentMonthKeyChicago();
                }
            }

            syncPosterMonthKey();

            let editing = null;
            const heading = document.getElementById('winnerFormHeading');
            const cancelEdit = document.getElementById('cancelWinnerEdit');
            function finishEditing() {
                editing = null;
                heading.textContent = 'Add Winner';
                addWinnerBtn.textContent = 'Add Winner';
                cancelEdit.hidden = true;
                wTicket.value = ''; wName.value = ''; wTown.value = ''; wPrize.value = ''; wPlace.value = '';
                window.dispatchEvent(new Event('raffle:winner-saved'));
            }
            cancelEdit.addEventListener('click', () => { finishEditing(); setWinnersStatus('info','Editing canceled. No changes saved.'); });
            window.addEventListener('raffle:edit-winner', event => {
                if (addWinnerBtn.disabled) return;
                const row = event.detail;
                if (row.raffleKey !== raffleMonth.value) return;
                editing = {...row};
                const parsed = parseWinnerPrize(row.prize);
                wDate.value = row.drawDate;
                wDate.dispatchEvent(new Event('change'));
                wTicket.value = row.ticketNumberText ?? String(row.ticketNumber);
                wName.value = row.name; wTown.value = row.town;
                wPrize.value = parsed.category ? parsed.category + ': ' + parsed.description : parsed.description;
                wPlace.value = parsed.position === null ? '' : parsed.position + (parsed.position===1?'st':parsed.position===2?'nd':'rd') + ' place';
                heading.textContent = 'Edit Winner — ' + row.name;
                addWinnerBtn.textContent = 'Save Changes'; cancelEdit.hidden = false;
                setWinnersStatus('info','Editing the selected winner. Save Changes updates this entry.');
                heading.scrollIntoView({behavior:'smooth',block:'start'}); heading.focus({preventScroll:true});
            });
            function renderWinners(rows) {
                const tbody = winnersTable.tBodies?.[0];
                if (!tbody) return;

                tbody.replaceChildren();
                winnersCount.textContent = rows.length ? `${rows.length} winner(s)` : "No winners yet.";

                for (const r of rows) {
                    const tr = document.createElement("tr");

                    // Date cell
                    const tdDate = document.createElement("td");
                    tdDate.className = "tdDate";

                    const time = document.createElement("time");
                    const iso = String(r.drawDate ?? "");
                    time.setAttribute("datetime", iso);
                    time.textContent = formatISODateMDY(iso);
                    tdDate.appendChild(time);

                    // Ticket cell
                    const tdTicket = document.createElement("td");
                    tdTicket.textContent = String(r.ticketNumberText ?? r.ticketNumber ?? "");

                    // Name cell
                    const tdName = document.createElement("td");
                    tdName.textContent = String(r.name ?? "");

                    // Town cell
                    const tdTown = document.createElement("td");
                    tdTown.textContent = String(r.town ?? "");

                    // Remove button cell
                    const tdActions = document.createElement("td");
                    tdActions.style.textAlign = "right";

                    const btn = document.createElement("button");
                    btn.className = "pill";
                    btn.type = "button";
                    btn.setAttribute("data-del", String(r.id ?? ""));
                    btn.textContent = "Remove";

                    const details = document.createElement("button");
                    details.type = "button";
                    details.className = "pill";
                    details.textContent = "Edit";
                    details.setAttribute("aria-label", `Edit winner for ticket ${r.ticketNumberText ?? r.ticketNumber}, ${r.name}`);
                    details.addEventListener("click", () => window.dispatchEvent(new CustomEvent("raffle:edit-winner", {detail:r})));
                    tdActions.append(details, btn);

                    const tdPrize = document.createElement("td");
                    const cells = prizeCells(r.prize ?? null);
                    tdPrize.className = "tdPrize";
                    tdPrize.textContent = cells.prize;
                    const tdPlace = document.createElement("td");
                    tdPlace.textContent = cells.place;
                    tr.append(tdDate, tdPlace, tdPrize, tdTicket, tdName, tdTown, tdActions);
                    tbody.appendChild(tr);
                    }
                }

            async function loadWinners() {
                setWinnersStatus("info", "Loading winners...");
                try {
                    const monthKey = raffleMonth.value || currentMonthKeyChicago();

                    const qs = new URLSearchParams({
                        raffleKey: monthKey,
                        includeMonths: "1",
                        includeMeta: "1",
                    });

                    const res = await fetch(`/api/admin/raffle/winners?${qs.toString()}`, {
                        headers: { "Accept": "application/json" }
                    });

                    const data = await res.json().catch(() => ({}));

                    if (raffleMonth.value !== monthKey) return;
                    if (res.ok && data?.ok) {
                        renderWinners(data.winners ?? []);
                        raffleTitle.value = (data.meta?.title ?? "").toString();
                        setWinnersStatus("info", "Winners loaded.");
                    } else {
                        setWinnersStatus("error", data?.error ?? "Failed to load winners.");
                    }
                } catch {
                    setWinnersStatus("error", "Failed to load winners.");
                }
            }

            window.addEventListener("raffle:prize-saved", loadWinners);
            window.addEventListener("raffle:winner-edited", loadWinners);
            const params = new URLSearchParams(location.search);

            function setPosterStatus(type, msg) {
                if (!posterStatus) return;
                posterStatus.textContent = msg || "";
                posterStatus.className = `status status--${type}`;
            }

            if (params.get("ok") === "poster") {
                setPosterStatus("ok", "Poster uploaded successfully.");
            } else if (params.get("err")) {
                setPosterStatus("err", "Poster upload failed.");
            }

            raffleMonth.addEventListener("change", async () => {
                wDate.value = `${raffleMonth.value}-01`;
                wPlace.selectedIndex = 0;
                updatePrizeSchedule();
                setMetaStatus("info", "");
                setWinnersStatus("info", "");
                syncPosterMonthKey();
                await loadWinners();
            });

            saveRaffleMetaBtn.addEventListener("click", async () => {
                const raffleKey = raffleMonth.value.trim();
                const title = raffleTitle.value.trim();

                setMetaStatus("success", "Saving...");
                saveRaffleMetaBtn.disabled = true;

                try {
                    const res = await fetch("/api/admin/raffle/winners", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "Accept": "application/json" },
                        body: JSON.stringify({ action: "setMeta", raffleKey, title }),
                    });

                    const data = await res.json().catch(() => ({}));
                    if (res.ok && data?.ok) {
                        setMetaStatus("info", title ? "Saved." : "Cleared for this month.");
                    } else {
                        setMetaStatus("error", data?.error ?? "Save failed.");
                    }
                } catch {
                    setMetaStatus("error", "Save failed.");
                } finally {
                    saveRaffleMetaBtn.disabled = false;
                }
            });

            addWinnerBtn.addEventListener("click", async () => {
                const dateMonth = wDate.value.slice(0, 7);
                if (!editing && dateMonth !== raffleMonth.value) {
                    setWinnersStatus("error", `Date must be within ${monthKeyToLabel(raffleMonth.value)}.`);
                    return;
                }

                if (!wDate.value || !/^[0-9]{1,9}$/.test(wTicket.value.trim()) || Number(wTicket.value)<=0 || wName.value.trim().length<2) {
                    setWinnersStatus('error','Enter a valid date, a positive ticket with 1–9 digits, and a winner name.'); return;
                }
                const wasEditing = !!editing;
                setWinnersStatus("success", "Saving...");
                raffleMonth.disabled = true; cancelEdit.disabled = true;
                addWinnerBtn.disabled = true;
                addWinnerBtn.setAttribute("aria-disabled", "true");

                try {
                    const payload = {
                        drawDate: wDate.value.trim(),
                        ticketNumber: wTicket.value.trim(),
                        name: wName.value.trim(),
                        town: wTown.value.trim(),
                        prize: [wPlace.value, wPrize.value.trim()].filter(Boolean).join(" — ") || null,
                    };

                    const res = await fetch("/api/admin/raffle/winners", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "Accept": "application/json" },
                        body: JSON.stringify(editing ? {action:"update",id:editing.id,expected:editing,winner:payload} : payload),
                    });

                    const data = await res.json().catch(() => ({}));
                    if (res.ok && data?.ok) {
                        finishEditing();
                        wTicket.focus();
                        // keep date for batch entry convenience
                        setWinnersStatus("info", "Winner saved.");
                        await loadWinners();
                        setWinnersStatus("success", wasEditing ? "Winner updated." : "Winner added.");
                    } else {
                        setWinnersStatus("error", data?.error ?? "Save failed.");
                    }
                } catch {
                    setWinnersStatus("error", "Save failed.");
                } finally {
                    raffleMonth.disabled = false; cancelEdit.disabled = false;
                    addWinnerBtn.disabled = false;
                    addWinnerBtn.setAttribute("aria-disabled", "false");
                }
            });

            winnersTable.addEventListener("click", async (e) => {
                const btn = e.target?.closest?.("button[data-del]");
                if (!btn) return;

                const id = btn.getAttribute("data-del");
                if (!id) return;

                if (!confirm("Remove this winner?")) { btn.disabled = false; return; }

                btn.disabled = true;
                setWinnersStatus("success", "Removing...");

                try {
                    const res = await fetch("/api/admin/raffle/winners", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "Accept": "application/json" },
                        body: JSON.stringify({ action: "delete", id }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (res.ok && data?.ok) {
                        setWinnersStatus("info", "Removed.");
                        await loadWinners();
                    } else {
                        setWinnersStatus("error", data?.error ?? "Remove failed.");
                    }
                } catch {
                    setWinnersStatus("error", "Remove failed.");
                } finally {
                    btn.disabled = false;
                }
            });
            wDate.addEventListener("change", () => {
                const dm = wDate.value.slice(0, 7);
                if (dm && dm !== raffleMonth.value) {
                    // keep the month selector consistent with the date they chose
                    raffleMonth.value = dm;
                    raffleMonth.dispatchEvent(new Event("change"));
                }
            });
            loadWinners();
        }
    </script>

